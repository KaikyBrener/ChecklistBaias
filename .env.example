# Copie para .env e ajuste. Tudo é opcional. NUNCA envie o arquivo .env ao git.

# Porta do servidor dentro do container/processo (o docker-compose publica em PORTA).
PORT=3000
#PORTA=3000

TZ_OPERACAO=America/Sao_Paulo
TURNO_DIA_HORA=7
TURNO_NOITE_HORA=19
PRAZO_CHECKLIST_MIN=60

# Só no primeiro start com banco vazio.
# - Em produção (NODE_ENV=production, caso da imagem Docker): se ADMIN_SENHA não for definida, uma senha
#   aleatória é gerada e impressa nos logs uma única vez. Troque após o primeiro acesso.
# - Em desenvolvimento (sem NODE_ENV=production): o padrão é admin / admin. Nunca use isso em servidor real.
# A senha precisa ter 8+ caracteres quando definida aqui.
ADMIN_LOGIN=admin
#ADMIN_SENHA=

# Segredo que assina a sessão (32+ caracteres aleatórios). Se ficar vazio, é gerado uma vez e guardado
# ao lado do banco (arquivo "segredo-sessao"). Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#JWT_SECRET=

# Use COOKIE_SECURE=1 somente se o acesso for por HTTPS (proxy reverso). Em HTTP puro (intranet) deixe fora.
# TRUST_PROXY=1 só quando houver proxy reverso confiável na frente (senão o limite de login usa o IP errado).
#COOKIE_SECURE=1
#TRUST_PROXY=1

# Só para o docker-compose.https.yml: nome (ou IP) que as pessoas digitam no navegador.
# Com esse arquivo, COOKIE_SECURE e TRUST_PROXY já são ligados automaticamente.
#DOMINIO=checklist.empresa.local

# Backup (node dist/backup.js)
#BACKUP_DIR=/data/backups
#BACKUP_MANTER=14

# Demonstração com dados fictícios (só funciona com banco vazio). NUNCA use junto com dados reais.
#DEMO=1
